{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowBulk Pro",
  "version": "1.0.0",
  "identifier": "app.flowbulk.pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "FlowBulk Pro", "width": 1000, "height": 760, "minWidth": 720, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
